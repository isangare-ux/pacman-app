##################################################
# .gitignore
# Schließt Dateien und Verzeichnisse von der
# Versionsverwaltung mit Git aus, die nicht im
# Repository gespeichert werden sollen.
##################################################
##################################################
# Git
##################################################

# Git-Metadaten und Konfigurationsdateien werden
# für den Docker-Build nicht benötigt.
.git
.gitignore

##################################################
# Node.js
##################################################

# Lokale Abhängigkeiten werden im Container mit
# "npm ci" neu installiert.
node_modules/

# Log-Dateien des Paketmanagers
npm-debug.log*
yarn-error.log*

# Optional: package-lock.json nur ausschließen,
# wenn bewusst darauf verzichtet wird.
package-lock.json

##################################################
# Dokumentation
##################################################

# Dokumentationen sind für die Ausführung der
# Anwendung im Container nicht erforderlich.
README.md
docs/

##################################################
# Tests
##################################################

# Testcode und Testergebnisse werden nicht in
# das Produktions-Image übernommen.
tests/
coverage/

##################################################
# Skripte
##################################################

# Temporäre Skripte oder lokale Hilfsdateien
# können ausgeschlossen werden.
scripts/*.tmp
scripts/*.log

##################################################
# Umgebungsvariablen
##################################################

# Sensible Konfigurationsdateien dürfen nicht
# Bestandteil des Images werden.
.env
.env.*

##################################################
# Betriebssystem
##################################################

# Betriebssystemspezifische Dateien ausschließen.
.DS_Store
Thumbs.db

##################################################
# Visual Studio Code
##################################################

# Lokale IDE-Konfigurationen gehören nicht ins Image.
.vscode/

##################################################
# Logs
##################################################

# Log-Dateien werden zur Laufzeit erzeugt.
logs/
*.log

##################################################
# Docker
##################################################

# Exportierte Docker-Images nicht übertragen.
*.tar

##################################################
# Kubernetes
##################################################

# Kubernetes-Konfigurationen sind für den Build
# nicht erforderlich.
.kube/
*.kube
kubeconfig

##################################################
# Temporäre Dateien
##################################################

# Temporäre Dateien ausschließen.
tmp/
temp/
*.tmp

##################################################
# Tokens
##################################################

# Zugangsdaten und Tokens dürfen niemals in
# das Docker-Image gelangen.
*.token
token.txt

##################################################
# Backups
##################################################

# Sicherungsdateien ausschließen.
backup/
backups/
*.bak
*.backup

##################################################
# Sonstiges
##################################################

# Temporäre Editor-Dateien ausschließen.
*.swp